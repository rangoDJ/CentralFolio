# SnapTrade Partner credentials (from your SnapTrade dashboard)
SNAPTRADE_CLIENT_ID=your_client_id
SNAPTRADE_CONSUMER_KEY=your_consumer_key

# The end-user identifier YOU choose for yourself in SnapTrade.
# Pick any stable string (e.g. "rango-personal-001"). It must be unique
# inside your SnapTrade partner account.
SNAPTRADE_USER_ID=rango-personal
